{
  "name": "specflow",
  "version": "0.1.0",
  "description": "Plan first, code second: a Claude Code workflow you add to any project.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhasishdasfreelance/specflow.git"
  },
  "bin": {
    "specflow": "bin/specflow.js"
  },
  "scripts": {
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:alpha": "node scripts/release.js alpha",
    "release:beta": "node scripts/release.js beta"
  },
  "files": [
    "bin",
    ".claude/hooks/*.py",
    ".claude/scripts/*.py",
    ".claude/skills/**/*.md",
    ".claude/settings.json",
    ".github/workflows/specflow-plans.yml",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=18"
  }
